($$nome-maria$$, $$Santíssimo Nome de Maria$$, $$Doce Nome de Maria$$, $$12 de Setembro$$, 9, 12, NULL, NULL, '{"Humanidade"}'::text[], $$Festa que celebra o santo nome de Maria, que significa "senhora" ou "estrela do mar".$$, $$Festa que celebra o santo nome de Maria, que significa "senhora" ou "estrela do mar".$$, $$[]$$::jsonb, '{"\"Ao ouvir o nome de Maria, o Céu se alegra e o inferno treme.\""}'::text[], $$virgin$$, $$https://upload.wikimedia.org/wikipedia/commons/thumb/4/4d/Sassoferrato_-_Jungfrun_i_b%C3%B6n_-_Google_Art_Project.jpg/440px-Sassoferrato_-_Jungfrun_i_b%C3%B6n_-_Google_Art_Project.jpg$$, NULL, '{"Devoção"}'::text[], $$[]$$::jsonb, '{}'::integer[], $$[]$$::jsonb),
