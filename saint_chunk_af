($$arcanjos$$, $$Santos Arcanjos Miguel, Gabriel e Rafael$$, $$Os Três Arcanjos$$, $$29 de Setembro$$, 9, 29, NULL, NULL, '{"Soldados","Polícia","Médicos"}'::text[], $$Os três arcanjos mencionados na Escritura: Miguel o defensor, Gabriel o mensageiro, Rafael o curador.$$, $$Os três arcanjos mencionados na Escritura: Miguel o defensor, Gabriel o mensageiro, Rafael o curador.$$, $$[]$$::jsonb, '{"\"Quem é como Deus?\""}'::text[], $$confessor$$, $$https://upload.wikimedia.org/wikipedia/commons/thumb/b/b3/Guido_Reni_031.jpg/440px-Guido_Reni_031.jpg$$, NULL, '{"Proteção","Mensagem","Cura"}'::text[], $$[]$$::jsonb, '{}'::integer[], $$[]$$::jsonb),
($$anjos-guarda$$, $$Santos Anjos da Guarda$$, $$Protetores Celestes$$, $$2 de Outubro$$, 10, 2, NULL, NULL, '{"Crianças","Vigilantes"}'::text[], $$Festa que celebra os anjos designados por Deus para guardar e proteger cada pessoa.$$, $$Festa que celebra os anjos designados por Deus para guardar e proteger cada pessoa.$$, $$[]$$::jsonb, '{"\"Ele enviará seus anjos para te guardar em todos os teus caminhos.\""}'::text[], $$confessor$$, $$https://upload.wikimedia.org/wikipedia/commons/thumb/c/c2/Bernardo_Strozzi_-_Guardian_Angel.jpg/440px-Bernardo_Strozzi_-_Guardian_Angel.jpg$$, NULL, '{"Proteção"}'::text[], $$[]$$::jsonb, '{}'::integer[], $$[]$$::jsonb),
