($$nossa-senhora-dores$$, $$Nossa Senhora das Dores$$, $$Mater Dolorosa$$, $$15 de Setembro$$, 9, 15, NULL, NULL, '{"Aflitos"}'::text[], $$Memória das sete dores de Maria: a profecia de Simeão, a fuga ao Egito, a perda de Jesus no Templo, o encontro na Via Crucis, a crucificação, a deposição e a sepultura.$$, $$Memória das sete dores de Maria: a profecia de Simeão, a fuga ao Egito, a perda de Jesus no Templo, o encontro na Via Crucis, a crucificação, a deposição e a sepultura.$$, $$[]$$::jsonb, '{"\"Uma espada traspassará a tua alma.\""}'::text[], $$virgin$$, $$https://upload.wikimedia.org/wikipedia/commons/thumb/5/59/Mater_Dolorosa_by_Carlo_Dolci.jpg/440px-Mater_Dolorosa_by_Carlo_Dolci.jpg$$, NULL, '{"Compaixão","Sofrimento"}'::text[], $$[]$$::jsonb, '{}'::integer[], $$[]$$::jsonb),
