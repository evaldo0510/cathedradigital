# Variáveis de ambiente do Cathedra (exemplo)
#
# Copie como `.env.local` (não commitado) para desenvolvimento.
# Em produção, configure no painel do provedor (Lovable / Vercel).

# ---- Supabase (autogerenciado pela Lovable Cloud, não editar) ----
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=

# ---- CI / SEO ----
# Domínio validado pelo job `gsc-meta-gate` e `prod-seo-http`.
# Também aceito como GitHub Actions variable `PROD_BASE_URL`.
PROD_BASE_URL=https://www.cathedradigital.com.br

# ---- Feature flags de módulos ----
# Sprint CQ-1 — ativa `src/modules/catequese/routes.tsx` (default 0 até CQ-1.4).
VITE_MODULES_CATEQUESE=0
