INSERT INTO public.saints (id, name, title, feast_day, feast_month, feast_day_num, born, died, patron_of, bio, full_bio, works, quotes, category, image, prayer, virtues, bible_refs, catechism_refs, church_doc_refs) VALUES
($$teresa-lisieux$$, $$Santa Teresa de Lisieux$$, $$A Pequena Flor$$, $$1 de Outubro$$, 10, 1, $$1873, Alençon, França$$, $$1897, Carmelo de Lisieux, França$$, '{"Missionários","Floristas","Aviadores","França"}'::text[], $$Carmelita descalça francesa, doutora da Igreja. Desenvolveu a "pequena via" da infância espiritual.$$, $$Marie-Françoise-Thérèse Martin foi a caçula de nove filhos de Louis e Zélie Martin — ambos canonizados como santos. Perdeu a mãe aos 4 anos, o que marcou profundamente sua sensibilidade. Desde muito cedo, sentiu o chamado à vida religiosa.

Aos 15 anos, após uma audiência com o Papa Leão XIII em Roma, obteve permissão especial para entrar no Carmelo de Lisieux, onde já estavam duas de suas irmãs. Recebeu o nome de Teresa do Menino Jesus e da Santa Face.

No Carmelo, Teresa desenvolveu sua célebre "pequena via" — um caminho de infância espiritual que consiste em fazer as coisas mais ordinárias com extraordinário amor. Compreendeu que não precisava realizar grandes feitos: "Minha vocação é o amor! No coração da Igreja, minha Mãe, eu serei o amor."

Os últimos 18 meses de vida foram marcados por uma terrível "noite da fé" — uma provação interior de dúvida contra a existência do Céu — que ela enfrentou com heroica confiança. Sofria também de tuberculose, que a consumiu lentamente.

Por obediência, escreveu sua autobiografia "História de uma Alma", que após sua morte se tornou um dos livros espirituais mais lidos do mundo. Morreu aos 24 anos dizendo: "Meu Deus, eu vos amo!" Foi canonizada em 1925 e declarada Doutora da Igreja por João Paulo II em 1997 — a mais jovem Doutora da história.$$, $$[{"title":"História de uma Alma (autobiografia)","url":"https://www.vatican.va/therese/therese_index_po.htm","year":"1895–1897"},{"title":"Poesias Completas","year":"1893–1897"},{"title":"Últimas Conversas (Novissima Verba)","year":"1897"},{"title":"Orações","year":"1889–1897"},{"title":"Peças de Teatro espirituais","year":"1893–1896"}]$$::jsonb, '{"\"Minha vocação é o amor! No coração da Igreja, minha Mãe, eu serei o amor.\"","\"Quero passar meu céu fazendo o bem na terra.\"","\"Tudo é graça.\"","\"O elevador que me há de elevar ao Céu são os vossos braços, ó Jesus!\""}'::text[], $$doctor$$, $$https://upload.wikimedia.org/wikipedia/commons/thumb/4/4e/Therese_von_Lisieux.jpg/440px-Therese_von_Lisieux.jpg$$, $$Santa Teresinha do Menino Jesus, fazei cair do céu uma chuva de rosas sobre aqueles que vos invocam. Ajudai-me a encontrar a santidade nas coisas pequenas.$$, '{"Simplicidade","Confiança","Amor","Infância espiritual"}'::text[], $$[]$$::jsonb, '{}'::integer[], $$[]$$::jsonb),
($$padre-pio$$, $$São Padre Pio de Pietrelcina$$, $$O Frade Estigmatizado$$, $$23 de Setembro$$, 9, 23, $$1887, Pietrelcina, Itália$$, $$1968, San Giovanni Rotondo, Itália$$, '{"Adolescentes","Confessores","Voluntários","Curandeiros"}'::text[], $$Frade capuchinho italiano que recebeu os estigmas de Cristo. Célebre confessor que atraiu milhões de fiéis.$$, $$Francesco Forgione nasceu numa família camponesa profundamente religiosa no sul da Itália. Desde criança experimentava visões e êxtases, assim como ataques demoníacos. Aos 15 anos entrou na Ordem dos Frades Menores Capuchinhos, recebendo o nome de Frei Pio.

Em 20 de setembro de 1918, enquanto rezava diante de um crucifixo na igreja do convento de San Giovanni Rotondo, recebeu os estigmas — as cinco chagas de Cristo — que carregou visivelmente durante 50 anos. Os estigmas sangravam continuamente, exalando perfume de flores.

O Padre Pio tornou-se famoso por seus dons extraordinários: bilocação (ser visto em dois lugares ao mesmo tempo), leitura de consciências (revelando pecados confessados de penitentes antes que os declarassem), perfume de santidade, e inúmeros milagres de cura. Passava até 19 horas por dia no confessionário, recebendo fiéis do mundo inteiro.

A celebração da Missa por Padre Pio durava frequentemente horas, sendo um momento de visível sofrimento e êxtase místico que comovia todos os presentes. Sofreu durante anos investigações eclesiásticas e restrições ao exercício do ministério, que aceitou com heroica obediência.

Fundou a Casa Alívio do Sofrimento, um hospital em San Giovanni Rotondo que hoje é um dos maiores centros médicos da Itália. Morreu em 23 de setembro de 1968. Quando seu corpo foi exumado em 2008, foi encontrado em notável estado de conservação. Foi canonizado por João Paulo II em 2002.$$, $$[{"title":"Epistolário (Cartas)","url":"https://www.padrepio.it/","year":"1910–1968"},{"title":"Grupos de Oração do Padre Pio","url":"https://www.padrepio.it/en/prayer-groups/"}]$$::jsonb, '{"\"Reze, espere e não se preocupe. A preocupação é inútil.\"","\"A oração é a melhor arma que temos; é a chave do coração de Deus.\"","\"O Rosário é a arma para estes tempos.\"","\"Através do estudo dos livros busca-se a Deus; pela meditação encontra-se.\""}'::text[], $$mystic$$, $$https://upload.wikimedia.org/wikipedia/commons/thumb/5/5f/Padre_Pio.jpg/440px-Padre_Pio.jpg$$, $$São Padre Pio, que trouxestes em vosso corpo as chagas de Cristo, rogai a Deus por nós e intercedei por nossas necessidades.$$, '{"Oração","Sofrimento redentor","Obediência","Caridade","Dor"}'::text[], $$[]$$::jsonb, '{}'::integer[], $$[]$$::jsonb),
($$joana-arc$$, $$Santa Joana d'Arc$$, $$A Donzela de Orléans$$, $$30 de Maio$$, 5, 30, $$1412, Domrémy, França$$, $$1431, Ruão, França$$, '{"França","Soldados","Prisioneiros","Mulheres militares"}'::text[], $$Heroína francesa e santa padroeira da França. Guiada por visões divinas, liderou o exército francês durante a Guerra dos Cem Anos.$$, $$Nascida numa família camponesa durante a Guerra dos Cem Anos, Joana começou a ouvir as vozes de São Miguel Arcanjo, Santa Catarina de Alexandria e Santa Margarida de Antioquia aos 13 anos. As vozes instruíram-na a libertar a França do domínio inglês e conduzir o Delfim Carlos VII à coroação.

Aos 17 anos, após superar a desconfiança inicial, convenceu o Delfim de sua missão divina. Recebeu uma armadura e um estandarte branco com flor-de-lis, e liderou o exército francês na libertação de Orléans em apenas nove dias (maio de 1429) — uma vitória que reverteu o curso da guerra. Conduziu Carlos VII à coroação em Reims em julho de 1429.

Capturada pelos borgonheses em Compiègne em maio de 1430, foi vendida aos ingleses, que a submeteram a um longo e cruel julgamento eclesiástico em Ruão. Acusada de heresia e bruxaria por vestir roupas masculinas e alegar comunicação direta com Deus, manteve suas afirmações com extraordinária coragem e lucidez, apesar de ser uma jovem camponesa analfabeta enfrentando os mais eruditos teólogos da época.

Foi condenada e queimada na fogueira em 30 de maio de 1431, aos 19 anos. Suas últimas palavras foram "Jesus! Jesus!" O processo foi anulado em 1456, e Joana foi canonizada por Bento XV em 1920.$$, $$[{"title":"Atas do Processo de Condenação (1431)","url":"https://www.sofrancois.org/jeanne-arc/proces/index.html","year":"1431"},{"title":"Atas do Processo de Reabilitação (1456)","year":"1456"},{"title":"Cartas de Joana d'Arc","year":"1429–1431"}]$$::jsonb, '{"\"Não tenho medo; para isto nasci.\"","\"Aja, e Deus agirá.\"","\"Prefiro morrer a fazer algo que sei ser pecado.\""}'::text[], $$martyr$$, $$https://upload.wikimedia.org/wikipedia/commons/thumb/3/39/Joan_of_Arc_miniature_graded.jpg/440px-Joan_of_Arc_miniature_graded.jpg$$, $$Santa Joana d'Arc, que com vossa coragem inabalável seguistes a vontade de Deus até o martírio, dai-nos a fortaleza para enfrentar as batalhas da nossa vida com fé.$$, '{"Coragem","Fé","Obediência a Deus","Fortaleza"}'::text[], $$[]$$::jsonb, '{}'::integer[], $$[]$$::jsonb),
($$antonio-padua$$, $$Santo Antônio de Pádua$$, $$Doutor Evangélico$$, $$13 de Junho$$, 6, 13, $$1195, Lisboa, Portugal$$, $$1231, Pádua, Itália$$, '{"Objetos perdidos","Pobres","Viajantes","Portugal","Casamentos"}'::text[], $$Frade franciscano português, famoso por sua pregação eloquente e profundo conhecimento das Escrituras.$$, $$Fernando Martins de Bulhões nasceu numa família nobre de Lisboa. Estudou com os cônegos regrantes de Santo Agostinho, onde adquiriu profundo conhecimento bíblico. A visão dos corpos dos primeiros mártires franciscanos em Marrocos acendeu nele o desejo do martírio, levando-o a ingressar na Ordem Franciscana, recebendo o nome de Antônio.

Partiu para Marrocos, mas uma doença grave forçou-o a regressar. Uma tempestade desviou o navio para a Sicília, onde participou de um capítulo geral da Ordem em Assis. Ali, por acaso, foi convidado a pregar quando nenhum outro pregador estava disponível — e revelou-se um orador tão extraordinário que São Francisco o encarregou de ensinar teologia aos frades.

Tornou-se o maior pregador de sua época, atraindo multidões tão grandes que igrejas não comportavam os ouvintes — pregava ao ar livre para dezenas de milhares. Seus sermões, profundamente bíblicos, combatiam a avareza, a usura e a heresia cátara. Era chamado "Arca do Testamento" pelo domínio enciclopédico das Escrituras.

Morreu aos 36 anos em Pádua. Foi canonizado apenas 11 meses após sua morte — a canonização mais rápida da história. Em 1946, foi proclamado Doutor da Igreja por Pio XII.$$, $$[{"title":"Sermões Dominicais e Festivos","url":"https://www.santantonio.org/it/content/i-sermoni","year":"1228–1231"},{"title":"Sermões para os Dias de Santos","year":"1229–1231"}]$$::jsonb, '{"\"As ações falam mais alto que as palavras; que as vossas palavras ensinem e as vossas ações falem.\"","\"Quem tem o Espírito Santo no coração sente facilidade no caminho de Deus.\""}'::text[], $$doctor$$, $$https://upload.wikimedia.org/wikipedia/commons/thumb/b/b5/Saint_Anthony_of_Padua.jpg/440px-Saint_Anthony_of_Padua.jpg$$, $$Santo Antônio, protetor dos pobres e patrono das coisas perdidas, intercedei por nós junto ao Senhor.$$, '{"Eloquência","Caridade","Humildade","Zelo"}'::text[], $$[]$$::jsonb, '{}'::integer[], $$[]$$::jsonb),
($$faustina$$, $$Santa Faustina Kowalska$$, $$Apóstola da Divina Misericórdia$$, $$5 de Outubro$$, 10, 5, $$1905, Głogowiec, Polônia$$, $$1938, Cracóvia, Polônia$$, '{"Divina Misericórdia"}'::text[], $$Religiosa polonesa que recebeu revelações de Jesus sobre a Divina Misericórdia, difundindo esta devoção por todo o mundo.$$, $$Helena Kowalska, terceira de dez filhos de uma família camponesa pobre, sentiu o chamado religioso desde os 7 anos. Após ser inicialmente rejeitada por várias congregações por falta de dote, foi aceita na Congregação das Irmãs de Nossa Senhora da Misericórdia em 1925, recebendo o nome de Irmã Maria Faustina.

A partir de 1931, recebeu uma série de visões e revelações de Jesus Cristo, que lhe pediu para propagar a devoção à Divina Misericórdia. Jesus apareceu-lhe vestido de branco, com raios vermelho e pálido emanando do coração, e pediu que fosse pintada esta imagem com a inscrição "Jesus, eu confio em Vós."

Jesus transmitiu-lhe a Coroa da Misericórdia, pediu a instituição da Festa da Misericórdia (Segundo Domingo de Páscoa) e revelou a Hora da Misericórdia (15h). Faustina registrou todas estas experiências no seu Diário — "A Misericórdia Divina na Minha Alma" — que se tornou um dos textos místicos mais importantes do século XX.

Apesar de sua pouca instrução formal, Faustina demonstrou uma profundidade teológica extraordinária em seus escritos. Sofreu incompreensão de suas superioras e de alguns confessores, mas encontrou apoio decisivo no Padre Michał Sopoćko.

Morreu de tuberculose aos 33 anos. Foi canonizada por João Paulo II em 2000, que também instituiu a Festa da Divina Misericórdia para toda a Igreja.$$, $$[{"title":"Diário: A Misericórdia Divina na Minha Alma","url":"https://www.faustyna.pl/zmbm/pt/","year":"1934–1938"}]$$::jsonb, '{"\"Jesus, eu confio em Vós.\"","\"A humanidade não encontrará paz enquanto não se voltar com confiança para a Minha Misericórdia.\"","\"Secretária da Minha Misericórdia, escreve, fala às almas sobre esta Minha grande Misericórdia.\"","\"Quanto maior o pecador, tanto maior o direito que tem à Minha Misericórdia.\""}'::text[], $$mystic$$, $$https://upload.wikimedia.org/wikipedia/commons/thumb/e/e4/Faustina_Kowalska.jpg/440px-Faustina_Kowalska.jpg$$, $$Jesus, eu confio em Vós! Santa Faustina, apóstola da Divina Misericórdia, ensinai-nos a confiar na infinita misericórdia de Deus.$$, '{"Confiança","Misericórdia","Oração","Abandono a Deus"}'::text[], $$[]$$::jsonb, '{}'::integer[], $$[]$$::jsonb)
