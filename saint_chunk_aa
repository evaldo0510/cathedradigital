INSERT INTO public.saints (id, name, title, feast_day, feast_month, feast_day_num, born, died, patron_of, bio, full_bio, works, quotes, category, image, prayer, virtues, bible_refs, catechism_refs, church_doc_refs) VALUES
($$thomas-aquinas$$, $$São Tomás de Aquino$$, $$Doctor Angelicus$$, $$28 de Janeiro$$, 1, 28, $$1225, Roccasecca, Itália$$, $$1274, Abadia de Fossanova, Itália$$, '{"Estudantes","Universidades","Filósofos","Teólogos","Livreiros"}'::text[], $$Frade dominicano, teólogo e filósofo italiano. Considerado o maior teólogo da Igreja Católica, autor da Suma Teológica.$$, $$Nascido numa família nobre, Tomás entrou para a Ordem dos Pregadores (Dominicanos) contra a vontade da família, que o manteve preso durante um ano para dissuadi-lo. Estudou em Paris e Colônia sob a orientação de Santo Alberto Magno. Tornou-se professor em Paris e Roma, onde compôs a sua obra-prima, a Suma Teológica, uma síntese monumental de toda a teologia cristã à luz da filosofia aristotélica.

Conhecido como o "Boi Mudo da Sicília" pelos colegas por seu silêncio contemplativo, Alberto Magno profetizou que seus mugidos seriam ouvidos pelo mundo inteiro. Tomás demonstrou que fé e razão não se contradizem, mas se complementam — a razão natural pode alcançar verdades sobre Deus, e a Revelação eleva o conhecimento humano a verdades sobrenaturais.

Escreveu mais de 60 obras, incluindo comentários sobre quase toda a Escritura, sobre Aristóteles, e tratados teológicos. Perto do fim da vida, após uma experiência mística durante a Missa, declarou: "Tudo o que escrevi parece-me palha em comparação com o que me foi revelado." Foi canonizado em 1323 e declarado Doutor da Igreja em 1567. Leão XIII proclamou-o padroeiro das escolas católicas em 1880.$$, $$[{"title":"Suma Teológica","url":"https://sumateologica.files.wordpress.com/2017/04/suma-teolc3b3gica.pdf","year":"1265–1274"},{"title":"Suma Contra os Gentios","url":"https://www.corpusthomisticum.org/scg1001.html","year":"1259–1265"},{"title":"Questões Disputadas sobre a Verdade","url":"https://www.corpusthomisticum.org/qdv01.html","year":"1256–1259"},{"title":"Comentário ao Evangelho de João","url":"https://www.corpusthomisticum.org/cio01.html","year":"1270–1272"},{"title":"De Ente et Essentia","url":"https://www.corpusthomisticum.org/oee.html","year":"1252–1256"},{"title":"Compêndio de Teologia","url":"https://www.corpusthomisticum.org/oct01.html","year":"1265–1267"}]$$::jsonb, '{"\"O temor é o princípio da sabedoria.\"","\"A graça não destrói a natureza, mas a aperfeiçoa.\"","\"Para quem tem fé, nenhuma explicação é necessária. Para quem não tem fé, nenhuma explicação é possível.\"","\"Tudo o que escrevi parece-me palha em comparação com o que me foi revelado.\""}'::text[], $$doctor$$, $$https://upload.wikimedia.org/wikipedia/commons/thumb/e/e3/St-thomas-aquinas.jpg/440px-St-thomas-aquinas.jpg$$, $$Concedei-me, Senhor, uma vontade que vos queira, uma mente que vos conheça, uma diligência que vos busque, uma sabedoria que vos encontre, uma vida que vos agrade, uma perseverança que vos espere e uma confiança que finalmente vos abrace.$$, '{"Sabedoria","Humildade","Pureza","Contemplação","Fé"}'::text[], $$[{"ref":"Jo 1,1","label":"No princípio era o Verbo"},{"ref":"Rm 1,20","label":"Conhecimento de Deus pela razão"}]$$::jsonb, '{36,156,159,2500}'::integer[], $$[{"title":"Aeterni Patris (Leão XIII)","url":"https://www.vatican.va/content/leo-xiii/pt/encyclicals/documents/hf_l-xiii_enc_04081879_aeterni-patris.html"},{"title":"Fides et Ratio (João Paulo II)","url":"https://www.vatican.va/content/john-paul-ii/pt/encyclicals/documents/hf_jp-ii_enc_14091998_fides-et-ratio.html"}]$$::jsonb),
($$agostinho$$, $$Santo Agostinho de Hipona$$, $$Doctor Gratiae$$, $$28 de Agosto$$, 8, 28, $$354, Tagaste, Numídia (atual Argélia)$$, $$430, Hipona, Numídia$$, '{"Teólogos","Cervejeiros","Impressores","Convertidos"}'::text[], $$Bispo de Hipona e um dos mais importantes Padres da Igreja. Sua conversão é um dos relatos mais célebres da literatura cristã.$$, $$Filho de Santa Mônica e de Patrício, um pagão, Agostinho viveu uma juventude dissoluta marcada pela busca intelectual. Passou pelo maniqueísmo, pelo ceticismo e pelo neoplatonismo antes de sua dramática conversão ao cristianismo em 386, narrada nas célebres Confissões.

A cena no jardim de Milão — ao ouvir uma voz infantil dizer "Tolle, lege" (Toma e lê) — levou-o a abrir a Carta aos Romanos, e nesse instante sua vida mudou para sempre. Foi batizado por Santo Ambrósio na Páscoa de 387.

Como bispo de Hipona durante 35 anos, Agostinho combateu vigorosamente as heresias do donatismo, do pelagianismo e do maniqueísmo. Sua obra A Cidade de Deus, escrita após o saque de Roma em 410, apresenta uma visão grandiosa da história humana como peregrinação entre duas "cidades" — a terrena e a celestial.

Agostinho é considerado o pai da teologia ocidental. Sua doutrina sobre a graça, o pecado original, a Trindade e a predestinação moldou profundamente o pensamento cristão. Morreu durante o cerco vândalo a Hipona, recitando os Salmos Penitenciais.$$, $$[{"title":"Confissões","url":"https://www.augustinus.it/portoghese/confessioni/index.htm","year":"397–400"},{"title":"A Cidade de Deus","url":"https://www.augustinus.it/portoghese/cdd/index.htm","year":"413–426"},{"title":"A Trindade (De Trinitate)","url":"https://www.augustinus.it/latino/trinita/index.htm","year":"400–416"},{"title":"Comentário aos Salmos","url":"https://www.augustinus.it/latino/esposizioni_salmi/index.htm","year":"392–418"},{"title":"Sobre a Doutrina Cristã","url":"https://www.augustinus.it/latino/dottrina_cristiana/index.htm","year":"396–426"},{"title":"Enquirídio (Manual da Fé, Esperança e Caridade)","url":"https://www.augustinus.it/latino/enchiridion/index.htm","year":"421"}]$$::jsonb, '{"\"Fizeste-nos para Ti, Senhor, e o nosso coração está inquieto enquanto não descansar em Ti.\"","\"Tarde te amei, ó Beleza tão antiga e tão nova, tarde te amei!\"","\"Ama e faze o que quiseres.\"","\"A medida do amor é amar sem medida.\""}'::text[], $$doctor$$, $$https://upload.wikimedia.org/wikipedia/commons/thumb/e/ea/Saint_Augustine_by_Philippe_de_Champaigne.jpg/440px-Saint_Augustine_by_Philippe_de_Champaigne.jpg$$, $$Tarde te amei, ó Beleza tão antiga e tão nova! Estavas dentro de mim e eu procurava-Te fora. Chamaste, gritaste, e rompeste a minha surdez.$$, '{"Contrição","Busca pela Verdade","Caridade","Perseverança","Identidade"}'::text[], $$[{"ref":"Sl 42,2","label":"A minha alma tem sede de Deus"},{"ref":"Rm 13,13-14","label":"Revesti-vos do Senhor Jesus Cristo"}]$$::jsonb, '{27,30,1718,2560}'::integer[], $$[{"title":"Augustinum Hipponensem (João Paulo II)","url":"https://www.vatican.va/content/john-paul-ii/pt/apost_letters/1986/documents/hf_jp-ii_apl_26081986_augustinum-hipponensem.html"}]$$::jsonb),
($$francisco-assis$$, $$São Francisco de Assis$$, $$Il Poverello$$, $$4 de Outubro$$, 10, 4, $$1181/1182, Assis, Itália$$, $$1226, Porciúncula, Assis$$, '{"Animais","Ecologia","Mercadores","Itália"}'::text[], $$Fundador da Ordem dos Frades Menores. Renunciou à riqueza para viver em pobreza radical, seguindo Cristo literalmente.$$, $$Filho de um rico comerciante de tecidos, o jovem Francisco viveu uma juventude mundana e sonhava com a glória militar. Após ser preso na guerra contra Perugia e sofrer uma grave doença, iniciou uma profunda conversão.

O momento decisivo veio quando, na igreja de São Damião, ouviu o crucifixo dizer: "Francisco, vai e repara a minha Igreja que, como vês, está em ruínas." Inicialmente interpretou literalmente a mensagem, restaurando igrejas abandonadas, mas logo compreendeu que era chamado a renovar toda a Igreja.

Despojou-se de tudo diante do bispo de Assis, devolvendo ao pai até as roupas, e abraçou a pobreza radical como "Senhora Pobreza". Atraiu seguidores e fundou a Ordem dos Frades Menores (Franciscanos), aprovada pelo Papa Inocêncio III em 1209. Fundou também a Segunda Ordem (Claras) com Santa Clara, e a Terceira Ordem para leigos.

Em 1219, durante a Quinta Cruzada, atravessou as linhas inimigas para dialogar com o sultão al-Kamil do Egito — um gesto profético de diálogo inter-religioso. Em 1224, no Monte Alverna, recebeu os estigmas — as chagas de Cristo — tornando-se o primeiro estigmatizado da história.

Compôs o Cântico das Criaturas, considerado uma das primeiras obras-primas da literatura italiana. Morreu em 1226 cantando o Salmo 141, e foi canonizado apenas dois anos depois.$$, $$[{"title":"Cântico das Criaturas","url":"https://www.franciscanos.org.br/?p=cantico-das-criaturas","year":"1224"},{"title":"Regra Bulada (Regra definitiva)","url":"https://www.vatican.va/content/francesco/pt/encyclicals/documents/papa-francesco_20150524_enciclica-laudato-si.html","year":"1223"},{"title":"Testamento de São Francisco","url":"https://www.ofm.org/en/sources/test-en/","year":"1226"},{"title":"Admoestações","year":"1220–1226"},{"title":"Carta a toda a Ordem","year":"1225–1226"}]$$::jsonb, '{"\"Senhor, fazei-me instrumento da vossa paz.\"","\"Pregai o Evangelho em todo o tempo; quando necessário, usai palavras.\"","\"Comecemos, irmãos, a servir o Senhor, porque até agora pouco ou nada fizemos.\""}'::text[], $$founder$$, $$https://upload.wikimedia.org/wikipedia/commons/thumb/f/f3/Giotto_di_Bondone_-_Legend_of_St_Francis_-_15._Sermon_to_the_Birds_-_WGA09139.jpg/440px-Giotto_di_Bondone_-_Legend_of_St_Francis_-_15._Sermon_to_the_Birds_-_WGA09139.jpg$$, $$Senhor, fazei-me instrumento de vossa paz. Onde houver ódio, que eu leve o amor; onde houver ofensa, que eu leve o perdão.$$, '{"Pobreza","Fraternidade","Alegria","Humildade"}'::text[], $$[{"ref":"Mt 10,7-10","label":"A missão dos doze"},{"ref":"Mt 19,21","label":"Vende tudo o que tens"}]$$::jsonb, '{301,344,125,1438,2444}'::integer[], $$[{"title":"Laudato Si (Papa Francisco)","url":"https://www.vatican.va/content/francesco/pt/encyclicals/documents/papa-francesco_20150524_enciclica-laudato-si.html"},{"title":"Fratelli Tutti (Papa Francisco)","url":"https://www.vatican.va/content/francesco/pt/encyclicals/documents/papa-francesco_20201003_enciclica-fratelli-tutti.html"}]$$::jsonb),
($$judas-tadeu$$, $$São Judas Tadeu$$, $$Padroeiro das Causas Impossíveis$$, $$28 de Outubro$$, 10, 28, $$Séc. I, Galileia, Palestina$$, $$Séc. I, Pérsia (atual Irã)$$, '{"Causas impossíveis","Casos desesperados","Hospitais"}'::text[], $$Um dos doze apóstolos, irmão de São Tiago Menor. Pregou o Evangelho na Mesopotâmia e Pérsia.$$, $$São Judas Tadeu, também chamado Judas Lebeu, foi um dos doze apóstolos de Jesus Cristo. O Evangelho o distingue claramente de Judas Iscariotes: "Judas, não o Iscariotes" (Jo 14,22). É identificado como irmão de São Tiago Menor, sendo ambos parentes de Jesus.

Durante a Última Ceia, Judas Tadeu fez a Jesus a pergunta: "Senhor, por que te manifestarás a nós e não ao mundo?" (Jo 14,22), ao que Jesus respondeu ensinando sobre a habitação da Trindade nos que o amam.

Após Pentecostes, pregou na Judeia, Samaria, Idumeia, Síria, Mesopotâmia e Pérsia. A tradição relata que evangelizou junto com o apóstolo São Simão e que ambos foram martirizados na Pérsia — Judas Tadeu com uma clava (maça) e uma alabarda, instrumentos com que é frequentemente representado.

É autor da Epístola de São Judas, uma das cartas canônicas do Novo Testamento, na qual adverte contra falsos mestres e exorta à perseverança na fé. A devoção popular o invoca especialmente nas causas impossíveis e desesperadas, devido ao seu nome ter sido durante séculos evitado por confusão com o traidor Judas Iscariotes — fazendo dele um dos santos "menos procurados" e, portanto, sempre disponível para ajudar.$$, $$[{"title":"Epístola de São Judas (Novo Testamento)","url":"https://www.vatican.va/archive/bible/nova_vulgata/documents/nova-vulgata_nt_epist-iudae_lt.html"}]$$::jsonb, '{"\"Mantenham-se no amor de Deus, esperando a misericórdia de nosso Senhor Jesus Cristo para a vida eterna.\" (Jd 1,21)","\"A vocês, misericórdia, paz e amor em abundância.\" (Jd 1,2)"}'::text[], $$apostle$$, $$https://upload.wikimedia.org/wikipedia/commons/thumb/5/59/Jude_the_Apostle.jpg/440px-Jude_the_Apostle.jpg$$, $$São Judas Tadeu, apóstolo glorioso, fiel servo e amigo de Jesus, o nome do traidor fez com que fôsseis esquecido por muitos. Mas a Igreja vos honra e invoca como padroeiro dos casos desesperados.$$, '{"Esperança","Perseverança","Fidelidade"}'::text[], $$[]$$::jsonb, '{}'::integer[], $$[]$$::jsonb),
($$charbel$$, $$São Charbel Makhlouf$$, $$O Eremita de Annaya$$, $$24 de Julho$$, 7, 24, $$1828, Beka Kafra, Líbano$$, $$1898, Annaya, Líbano$$, '{"Pessoas doentes","Paz","Cura","Líbano"}'::text[], $$Monge maronita libanês, viveu como eremita por 23 anos. Famoso por inúmeros milagres durante e após sua vida.$$, $$Youssef Antoun Makhlouf nasceu numa pequena aldeia no norte do Líbano, o mais novo de cinco filhos. Desde a infância, demonstrou profunda inclinação à oração e ao silêncio, cuidando de um pequeno rebanho enquanto rezava por horas.

Aos 23 anos, deixou a casa sem avisar a família e entrou no mosteiro de Nossa Senhora de Mayfouq, da Ordem Libanesa Maronita, recebendo o nome de Charbel — em honra a um mártir de Antioquia do século II.

Após a ordenação sacerdotal em 1859, viveu 16 anos de vida comunitária no Mosteiro de Annaya, distinguindo-se pela obediência absoluta, pelo amor à Eucaristia e pela penitência rigorosa. Em 1875, obteve permissão para viver como eremita no eremitério de São Pedro e Paulo, onde permaneceu os últimos 23 anos de vida em intensa oração, jejum e trabalho manual.

No dia 16 de dezembro de 1898, sofreu um derrame durante a celebração da Missa, no momento da elevação do cálice. Morreu na véspera de Natal. Após o sepultamento, uma luz misteriosa foi vista sobre seu túmulo durante 45 noites. Quando o corpo foi exumado, foi encontrado incorrupto e exsudando um líquido oleoso com fragrância — fenômeno que continuou por décadas.

São Charbel é creditado com milhares de milagres no mundo inteiro, especialmente curas. Foi beatificado em 1965 durante o Concílio Vaticano II e canonizado por Paulo VI em 1977.$$, $$[]$$::jsonb, '{"\"O silêncio fala a Deus.\"","\"Quem permanece em Deus, Deus permanece nele.\""}'::text[], $$mystic$$, $$https://upload.wikimedia.org/wikipedia/commons/thumb/4/4b/Saint_Charbel_Makhlouf.jpg/440px-Saint_Charbel_Makhlouf.jpg$$, $$Senhor Deus Todo-Poderoso, que manifestastes ao mundo a santidade do monge Charbel, concedei-nos, por sua intercessão, a graça que humildemente vos pedimos.$$, '{"Silêncio","Oração","Penitência","Obediência"}'::text[], $$[]$$::jsonb, '{}'::integer[], $$[]$$::jsonb)
