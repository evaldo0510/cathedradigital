{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/planos",
      "destination": "/pricing",
      "permanent": true
    },
    {
      "source": "/planos/:path*",
      "destination": "/pricing",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/pricing",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" },
        {
          "key": "Link",
          "value": "<https://www.cathedradigital.com.br/pricing>; rel=\"canonical\""
        }
      ]
    },
    {
      "//": "/planos é 301 → /pricing. Não emitimos noindex no redirect: Google desaconselha combinar 301 com noindex (o sinal de consolidação da autoridade se perde). A desindexação do alias é garantida pelo próprio redirect e por ROUTE_META['/planos'] (SPA fallback em dev/preview)."
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ]
}
