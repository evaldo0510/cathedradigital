{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "bun run scripts/generate-sitemap.ts && bun run scripts/seo-checklist.ts",
    "build": "vite build",
    "seo:checklist": "bun run scripts/seo-checklist.ts",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "task-master": "bun run scripts/task-master.ts",
    "task-master:run": "bun run scripts/task-master.ts run",
    "task-master:status": "bun run scripts/task-master.ts status",
    "design-system:audit": "node scripts/design-system-audit.js",
    "design-system:fix-icons": "node scripts/fix-icons.js",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:bible-i18n": "bun x vitest run src/test/BibleZeroEnglish.test.ts",
    "test:local:unit": "CI=true vitest run",
    "test:local:e2e": "CI=true VITE_SWIPE_THRESHOLD=80 VITE_SWIPE_RATIO=2.5 npx playwright test tests/e2e/i18n-coverage.spec.ts tests/e2e/catechism-cache-regression.spec.ts tests/e2e/catechism-cache.spec.ts --project=chromium --project=firefox --project=webkit --project=mobile-chrome --project=mobile-safari",
    "test:e2e:headless": "HEADLESS=true CI=true VITE_SWIPE_THRESHOLD=80 VITE_SWIPE_RATIO=2.5 npx playwright test tests/e2e/i18n-coverage.spec.ts tests/e2e/catechism-cache-regression.spec.ts tests/e2e/catechism-cache.spec.ts --project=chromium --project=firefox --project=webkit --project=mobile-chrome --project=mobile-safari --reporter=list,html",
    "test:e2e:ci-replica": "bun run scripts/generate-i18n-report.ts && HEADLESS=true CI=true VITE_SWIPE_THRESHOLD=80 VITE_SWIPE_RATIO=2.5 npx playwright test tests/e2e/i18n-coverage.spec.ts tests/e2e/catechism-cache-regression.spec.ts tests/e2e/catechism-cache.spec.ts --project=chromium --project=firefox --project=webkit --project=mobile-chrome --project=mobile-safari --reporter=list,html",
    "test:e2e:last-failed": "HEADLESS=true CI=true VITE_SWIPE_THRESHOLD=80 VITE_SWIPE_RATIO=2.5 npx playwright test --last-failed",
    "test:e2e:ci-replica-failed": "npm run test:e2e:last-failed",
    "test:e2e:sync-artifacts": "node scripts/sync-artifacts.js",
    "---doc:e2e---": "Ajuste via VITE_SWIPE_THRESHOLD (80) e VITE_SWIPE_RATIO (2.5). CI vars: RETENTION_DAYS_HTML (7), RETENTION_DAYS_SCREENSHOTS (3), RETENTION_DAYS_VIDEOS (3), RETENTION_DAYS_TRACES (3). Sync flags: --device, --test, --run-id.",
    "test:local:axe": "CI=true npx playwright test tests/e2e/accessibility.spec.ts",
    "test:ci": "vitest run --coverage --reporter=default --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:header-mobile": "playwright test tests/e2e/header-mobile.spec.ts",
    "test:seo-audit": "playwright test tests/e2e/home-seo.spec.ts tests/e2e/seo-consistency.spec.ts",
    "test:visual": "playwright test tests/e2e/visual-regression.spec.ts",
    "test:audit": "bun run scripts/run-visual-regression.ts",
    "test:a11y": "playwright test tests/e2e/icon-a11y-navigation.spec.ts",
    "test:report": "playwright test tests/e2e/generate-final-report.spec.ts",
    "test:pdf": "bun run scripts/generate-pdf-report.ts",
    "test:performance": "playwright test tests/performance/mobile-performance.spec.ts",
    "test:system-audit": "bun run scripts/audit-visual-system.ts",
    "test:sitemap": "bun run scripts/validate-sitemap.ts",
    "test:spacing-audit": "bun run scripts/audit-spacing.ts",
    "test:mobile-ux": "playwright test tests/e2e/mobile-ux-metrics.spec.ts && bun run scripts/check-ux-regressions.ts && bun run scripts/generate-ux-metrics-report.ts",
    "test:clicabilidade": "playwright test tests/e2e/catecismo-clicabilidade.spec.ts",
    "test:nexus-anchor": "playwright test tests/e2e/nexus-popover-anchor.spec.ts",
    "test:nexus-keyboard": "playwright test tests/e2e/nexus-popover-keyboard.spec.ts",
    "test:nexus-suite": "playwright test tests/e2e/nexus-popover-suite.spec.ts",
    "test:nexus-suite-ext": "playwright test tests/e2e/nexus-popover-suite-ext.spec.ts",
    "test:nexus-hardening": "playwright test tests/e2e/nexus-popover-hardening.spec.ts",
    "test:nexus-hardening:ci": "playwright test tests/e2e/nexus-popover-hardening.spec.ts --reporter=list,html",
    "test:nexus-hardening:update": "playwright test tests/e2e/nexus-popover-hardening.spec.ts --update-snapshots",
    "test:bible-selection": "playwright test tests/e2e/bible-selection-keyboard.spec.ts",
    "test:bible-selection:update": "playwright test tests/e2e/bible-selection-keyboard.spec.ts --update-snapshots",
    "test:bible-selection-a11y": "playwright test tests/e2e/bible-selection-a11y-kb.spec.ts",
    "test:bible-selection-focus": "playwright test tests/e2e/bible-selection-focus.spec.ts",
    "test:bible-selection-ci": "playwright test tests/e2e/bible-selection-a11y-kb.spec.ts tests/e2e/bible-selection-keyboard.spec.ts tests/e2e/bible-selection-focus.spec.ts --reporter=list,html,json",
    "test:atrium-menu": "playwright test tests/e2e/atrium-menu-navigation.spec.ts",
    "test:atrium-landmarks": "playwright test tests/e2e/atrium-landmarks-a11y.spec.ts",
    "test:atrium-history": "playwright test tests/e2e/atrium-history.spec.ts",
    "test:atrium-footer": "playwright test tests/e2e/atrium-footer.spec.ts",
    "test:atrium-suite": "playwright test tests/e2e/atrium-menu-navigation.spec.ts tests/e2e/atrium-landmarks-a11y.spec.ts tests/e2e/atrium-history.spec.ts tests/e2e/atrium-footer.spec.ts --reporter=list,html,json",






    "test:catecismo:a11y": "playwright test tests/e2e/catecismo-a11y-avancado.spec.ts",
    "chromatic": "npx chromatic --project-token=$CHROMATIC_PROJECT_TOKEN --playwright",
    "generate:seo": "bun run scripts/generate-sitemap.ts",
    "token-audit": "bun run scripts/cathedra-audit.ts",
    "token-audit:ci": "npm run token-audit:clean && CI=true bun run scripts/cathedra-audit.ts",
    "token-audit:fix": "npm run token-audit:clean && bun run scripts/cathedra-audit.ts --fix --threshold=0",
    "token-audit:dry-run": "bun run scripts/cathedra-audit.ts --dry-run --threshold=0",
    "token-audit:report": "bun run scripts/cathedra-audit.ts --dry-run --threshold=0 --soft",
    "token-audit:clean": "rm -rf reports && mkdir -p reports",
    "reports:tree": "bun run scripts/reports-tree.ts",
    "reports:verify": "bun run scripts/verify-reports.ts --fail-on-divergence",
    "reports:clean": "bun run scripts/reports-clean.ts",
    "security-audit": "bun run scripts/security-audit.ts",
    "governance:all": "bun x concurrently \"npm run token-audit\" \"npm run test:system-audit\" \"npm run test:spacing-audit\" \"npm run security-audit\" \"npm run test:sitemap\"",
    "prepare": "husky",
    "test:token-audit": "vitest run scripts/cathedra-audit.test.ts",
    "check-all": "npm run lint && npm run typecheck && npm run test:local:unit && npm run token-audit:ci && npm run test:local:axe",
    "test:update-baselines": "playwright test --update-snapshots",
    "ci:validate": "npm run test:a11y && npm run test:report",
    "axe:contrast": "bunx tsx scripts/axe-contrast-run.ts",
    "axe:contrast:aggregate": "bunx tsx scripts/axe-contrast-heatmap.ts",
    "axe:contrast:tracked-all": "bunx tsx scripts/axe-contrast-run.ts --all-tracked --aggregate",
    "axe:contrast:autofix": "bunx tsx scripts/axe-contrast-run.ts --autofix --aggregate"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.11.3",
