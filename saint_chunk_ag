($$francisco-xavier$$, $$São Francisco Xavier$$, $$Apóstolo do Oriente$$, $$3 de Dezembro$$, 12, 3, $$1506, Navarra$$, $$1552, Ilha de Sanchoão$$, '{"Missionários","Turismo"}'::text[], $$Jesuíta co-fundador, missionário nas Índias, Malásia e Japão. Batizou mais de 30 mil pessoas.$$, $$Jesuíta co-fundador, missionário nas Índias, Malásia e Japão. Batizou mais de 30 mil pessoas.$$, $$[]$$::jsonb, '{"\"Quantas almas deixam de ir ao Céu por falta de quem as ensine!\""}'::text[], $$confessor$$, $$https://upload.wikimedia.org/wikipedia/commons/thumb/d/db/Fran%C3%A7ois-Xavier.jpg/440px-Fran%C3%A7ois-Xavier.jpg$$, NULL, '{"Missão","Zelo"}'::text[], $$[]$$::jsonb, '{}'::integer[], $$[]$$::jsonb),
($$barbara$$, $$Santa Bárbara$$, $$Protetora contra Raios$$, $$4 de Dezembro$$, 12, 4, $$Séc. III, Nicomédia$$, $$306, Nicomédia$$, '{"Artilheiros","Mineradores","Bombeiros"}'::text[], $$Virgem e mártir presa numa torre por seu pai pagão. Converteu-se ao cristianismo e foi decapitada pelo próprio pai.$$, $$Virgem e mártir presa numa torre por seu pai pagão. Converteu-se ao cristianismo e foi decapitada pelo próprio pai.$$, $$[]$$::jsonb, '{"\"Cristo é minha fortaleza e minha torre.\""}'::text[], $$martyr$$, $$https://upload.wikimedia.org/wikipedia/commons/thumb/a/a0/Robert_Campin_-_Saint_Barbara_-_Google_Art_Project.jpg/440px-Robert_Campin_-_Saint_Barbara_-_Google_Art_Project.jpg$$, NULL, '{"Fortaleza","Fé"}'::text[], $$[]$$::jsonb, '{}'::integer[], $$[]$$::jsonb),
($$nicolau$$, $$São Nicolau$$, $$Bispo de Mira$$, $$6 de Dezembro$$, 12, 6, $$270, Patara$$, $$343, Mira$$, '{"Crianças","Marinheiros","Comerciantes"}'::text[], $$Bispo generoso que secretamente dava presentes aos pobres. Inspiração para a figura do Papai Noel.$$, $$Bispo generoso que secretamente dava presentes aos pobres. Inspiração para a figura do Papai Noel.$$, $$[]$$::jsonb, '{"\"A generosidade é a melhor forma de pregar o Evangelho.\""}'::text[], $$confessor$$, $$https://upload.wikimedia.org/wikipedia/commons/thumb/5/5a/Jan_Matejko_-_Saint_Nicholas.PNG/440px-Jan_Matejko_-_Saint_Nicholas.PNG$$, NULL, '{"Generosidade","Proteção"}'::text[], $$[]$$::jsonb, '{}'::integer[], $$[]$$::jsonb),
($$ambrosio$$, $$Santo Ambrósio$$, $$Doutor da Igreja$$, $$7 de Dezembro$$, 12, 7, $$340, Tréveris$$, $$397, Milão$$, '{"Apicultores","Milão"}'::text[], $$Bispo de Milão que batizou Santo Agostinho. Grande pregador e defensor da Igreja contra o arianismo.$$, $$Bispo de Milão que batizou Santo Agostinho. Grande pregador e defensor da Igreja contra o arianismo.$$, $$[]$$::jsonb, '{"\"Onde está Pedro, aí está a Igreja.\""}'::text[], $$doctor$$, $$https://upload.wikimedia.org/wikipedia/commons/thumb/7/78/Ambrosius_of_Milan.jpg/440px-Ambrosius_of_Milan.jpg$$, NULL, '{"Eloquência","Coragem"}'::text[], $$[]$$::jsonb, '{}'::integer[], $$[]$$::jsonb),
($$imaculada-conceicao$$, $$Imaculada Conceição$$, $$Concebida sem Pecado$$, $$8 de Dezembro$$, 12, 8, NULL, NULL, '{"Portugal","Brasil","Estados Unidos"}'::text[], $$Solenidade que celebra o dogma de que Maria foi concebida sem pecado original, definido por Pio IX em 1854.$$, $$Solenidade que celebra o dogma de que Maria foi concebida sem pecado original, definido por Pio IX em 1854.$$, $$[]$$::jsonb, '{"\"Eu sou a Imaculada Conceição.\""}'::text[], $$virgin$$, $$https://upload.wikimedia.org/wikipedia/commons/thumb/5/5c/Bartolom%C3%A9_Esteban_Murillo_-_The_Immaculate_Conception_of_the_Venerable_Ones_-_Google_Art_Project.jpg/440px-Bartolom%C3%A9_Esteban_Murillo_-_The_Immaculate_Conception_of_the_Venerable_Ones_-_Google_Art_Project.jpg$$, NULL, '{"Pureza","Graça"}'::text[], $$[]$$::jsonb, '{}'::integer[], $$[]$$::jsonb)
