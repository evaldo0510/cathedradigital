($$nossa-senhora-aparecida$$, $$Nossa Senhora Aparecida$$, $$Padroeira do Brasil$$, $$12 de Outubro$$, 10, 12, NULL, NULL, '{"Brasil"}'::text[], $$Em 1717, três pescadores encontraram a imagem da Imaculada Conceição no Rio Paraíba do Sul. Foi proclamada Rainha e Padroeira do Brasil em 1930.$$, $$Em 1717, três pescadores encontraram a imagem da Imaculada Conceição no Rio Paraíba do Sul. Foi proclamada Rainha e Padroeira do Brasil em 1930.$$, $$[]$$::jsonb, '{"\"Sou a serva do Senhor.\""}'::text[], $$virgin$$, $$https://upload.wikimedia.org/wikipedia/commons/thumb/1/1d/Nossa_Senhora_Aparecida.jpg/440px-Nossa_Senhora_Aparecida.jpg$$, NULL, '{"Maternidade","Humildade"}'::text[], $$[]$$::jsonb, '{}'::integer[], $$[]$$::jsonb),
($$lucas$$, $$São Lucas Evangelista$$, $$O Evangelista Médico$$, $$18 de Outubro$$, 10, 18, $$Séc. I, Antioquia$$, $$Séc. I, Beócia$$, '{"Médicos","Pintores","Artistas"}'::text[], $$Médico grego, companheiro de São Paulo, autor do terceiro Evangelho e dos Atos dos Apóstolos.$$, $$Médico grego, companheiro de São Paulo, autor do terceiro Evangelho e dos Atos dos Apóstolos.$$, $$[]$$::jsonb, '{"\"Pareceu-me bem, depois de tudo ter investigado, escrever-te uma narração ordenada.\""}'::text[], $$apostle$$, $$https://upload.wikimedia.org/wikipedia/commons/thumb/2/2f/Simone_Martini_and_Lippo_Memmi_-_The_Annunciation_and_Two_Saints_-_WGA15010.jpg/440px-Simone_Martini_and_Lippo_Memmi_-_The_Annunciation_and_Two_Saints_-_WGA15010.jpg$$, NULL, '{"Investigação","Compaixão"}'::text[], $$[]$$::jsonb, '{}'::integer[], $$[]$$::jsonb),
($$frei-galvao$$, $$São Frei Galvão$$, $$O Santo das Pílulas$$, $$25 de Outubro$$, 10, 25, $$1739, Guaratinguetá, Brasil$$, $$1822, São Paulo$$, '{"Grávidas","Arquitetos"}'::text[], $$Primeiro santo nascido no Brasil, famoso por sua caridade e pelas "Pílulas de Frei Galvão".$$, $$Primeiro santo nascido no Brasil, famoso por sua caridade e pelas "Pílulas de Frei Galvão".$$, $$[]$$::jsonb, '{"\"Depois do parto, a Virgem permaneceu intacta.\""}'::text[], $$confessor$$, $$https://upload.wikimedia.org/wikipedia/commons/thumb/f/f4/Fra_Angelico_031.jpg/440px-Fra_Angelico_031.jpg$$, NULL, '{"Caridade","Pureza"}'::text[], $$[]$$::jsonb, '{}'::integer[], $$[]$$::jsonb),
($$todos-santos$$, $$Todos os Santos$$, $$Solenidade de Todos os Santos$$, $$1 de Novembro$$, 11, 1, NULL, NULL, '{"Igreja Triunfante"}'::text[], $$Solenidade que celebra todos os santos, conhecidos e desconhecidos, que já contemplam a face de Deus no Céu.$$, $$Solenidade que celebra todos os santos, conhecidos e desconhecidos, que já contemplam a face de Deus no Céu.$$, $$[]$$::jsonb, '{"\"Bem-aventurados os puros de coração, pois verão a Deus.\""}'::text[], $$confessor$$, $$https://upload.wikimedia.org/wikipedia/commons/thumb/3/38/Albrecht_D%C3%BCrer_-_Adoration_of_the_Trinity_%28Landauer_Altar%29_-_Google_Art_Project.jpg/440px-Albrecht_D%C3%BCrer_-_Adoration_of_the_Trinity_%28Landauer_Altar%29_-_Google_Art_Project.jpg$$, NULL, '{"Santidade"}'::text[], $$[]$$::jsonb, '{}'::integer[], $$[]$$::jsonb),
($$fieis-defuntos$$, $$Fiéis Defuntos$$, $$Comemoração dos Fiéis Defuntos$$, $$2 de Novembro$$, 11, 2, NULL, NULL, '{"Almas do Purgatório"}'::text[], $$Dia dedicado à oração pelas almas do Purgatório, para que alcancem a visão beatífica de Deus.$$, $$Dia dedicado à oração pelas almas do Purgatório, para que alcancem a visão beatífica de Deus.$$, $$[]$$::jsonb, '{"\"Dai-lhes, Senhor, o repouso eterno.\""}'::text[], $$confessor$$, $$https://upload.wikimedia.org/wikipedia/commons/thumb/f/fb/Bouguereau-The_Day_of_the_Dead.jpg/440px-Bouguereau-The_Day_of_the_Dead.jpg$$, NULL, '{"Oração pelos mortos"}'::text[], $$[]$$::jsonb, '{}'::integer[], $$[]$$::jsonb)
