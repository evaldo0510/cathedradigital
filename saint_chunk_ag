($$nossa-senhora-guadalupe$$, $$Nossa Senhora de Guadalupe$$, $$Padroeira das Américas$$, $$12 de Dezembro$$, 12, 12, NULL, NULL, '{"Américas","México"}'::text[], $$Em 1531, a Virgem Maria apareceu ao indígena Juan Diego no México, deixando sua imagem milagrosamente impressa em sua tilma.$$, $$Em 1531, a Virgem Maria apareceu ao indígena Juan Diego no México, deixando sua imagem milagrosamente impressa em sua tilma.$$, $$[]$$::jsonb, '{"\"Não estou eu aqui, que sou tua Mãe?\""}'::text[], $$virgin$$, $$https://upload.wikimedia.org/wikipedia/commons/thumb/2/2c/Virgen_de_guadalupe1.jpg/440px-Virgen_de_guadalupe1.jpg$$, NULL, '{"Maternidade","Evangelização"}'::text[], $$[]$$::jsonb, '{}'::integer[], $$[]$$::jsonb),
($$joao-cruz$$, $$São João da Cruz$$, $$Doutor Místico$$, $$14 de Dezembro$$, 12, 14, $$1542, Fontiveros$$, $$1591, Úbeda$$, '{"Contemplativos","Poetas"}'::text[], $$Carmelita e místico espanhol, reformador da Ordem com Santa Teresa. Autor de Noite Escura e Cântico Espiritual.$$, $$Carmelita e místico espanhol, reformador da Ordem com Santa Teresa. Autor de Noite Escura e Cântico Espiritual.$$, $$[]$$::jsonb, '{"\"Onde não há amor, ponha amor e recolherás amor.\""}'::text[], $$doctor$$, $$https://upload.wikimedia.org/wikipedia/commons/thumb/d/d3/John_of_the_Cross_drawing.png/440px-John_of_the_Cross_drawing.png$$, NULL, '{"Contemplação","Purificação"}'::text[], $$[]$$::jsonb, '{}'::integer[], $$[]$$::jsonb),
($$natal$$, $$Natividade do Senhor$$, $$O Natal de Jesus Cristo$$, $$25 de Dezembro$$, 12, 25, NULL, NULL, '{"Humanidade"}'::text[], $$Solenidade máxima que celebra o nascimento de Jesus Cristo em Belém, a Encarnação do Verbo de Deus.$$, $$Solenidade máxima que celebra o nascimento de Jesus Cristo em Belém, a Encarnação do Verbo de Deus.$$, $$[]$$::jsonb, '{"\"Glória a Deus nas alturas e paz na terra aos homens de boa vontade.\""}'::text[], $$confessor$$, $$https://upload.wikimedia.org/wikipedia/commons/thumb/f/f1/Gerard_van_Honthorst_001.jpg/440px-Gerard_van_Honthorst_001.jpg$$, NULL, '{"Encarnação","Humildade"}'::text[], $$[]$$::jsonb, '{}'::integer[], $$[]$$::jsonb),
($$estevao$$, $$Santo Estêvão$$, $$Protomártir$$, $$26 de Dezembro$$, 12, 26, $$Séc. I, Jerusalém$$, $$34, Jerusalém$$, '{"Diáconos"}'::text[], $$Primeiro mártir cristão, apedrejado em Jerusalém. Diácono cheio do Espírito Santo, viu o Céu aberto antes de morrer.$$, $$Primeiro mártir cristão, apedrejado em Jerusalém. Diácono cheio do Espírito Santo, viu o Céu aberto antes de morrer.$$, $$[]$$::jsonb, '{"\"Senhor, não lhes imputes este pecado.\""}'::text[], $$martyr$$, $$https://upload.wikimedia.org/wikipedia/commons/thumb/1/13/Giacinto_Gimignani_-_The_Stoning_of_St_Stephen.jpg/440px-Giacinto_Gimignani_-_The_Stoning_of_St_Stephen.jpg$$, NULL, '{"Perdão","Coragem"}'::text[], $$[]$$::jsonb, '{}'::integer[], $$[]$$::jsonb),
